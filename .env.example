# Đường dẫn file SQLite (mặc định: data/solo.db)
# DATABASE_PATH=/app/data/solo.db

# URL công khai của app, dùng cho CORS của Socket.IO
NEXTAUTH_URL=http://localhost:3000
# Khoá ký token người chơi. Tạo bằng: openssl rand -base64 32
# (Không còn dùng NextAuth; giữ tên biến để không phải đổi cấu hình trên server)
NEXTAUTH_SECRET=your-secret-key-here

# Socket.io (để trống khi chạy chung server với web)
NEXT_PUBLIC_SOCKET_URL=
